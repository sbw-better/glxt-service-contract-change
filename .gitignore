# Maven构建产物
/target/
*.class
dependency-reduced-pom.xml

# IDE配置
/.idea/
/.vscode/
/out/
*.iml
*.ipr
*.iws

# 日志和运行时文件
/logs/
/work/
*.log

# 本地环境及敏感配置
.env
.env.*
!.env.example
application-local.yml

# 操作系统文件
.DS_Store
Thumbs.db
Desktop.ini

# 编辑器和临时文件
*.tmp
*.swp
*.swo
*~
~$*
*.orig
*.rej

# Node.js依赖（文档、PPT、Excel生成工具会临时使用）
**/node_modules/

# Python缓存（测试数据生成与校验脚本）
__pycache__/
*.py[cod]

# 本地文档渲染与校验临时产物
