    {
      "name": "02 预测识别",
      "item": [
        {
          "name": "EXACT_完全相同段落",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "UserId",
                "value": "{{userId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paragraph\": \"基金管理人：上海丹羿投资管理合伙企业（普通合伙）\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/service/contract-change/predict",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "service",
                "contract-change",
                "predict"
              ]
            },
            "description": "命中Hash，matchType=EXACT，不调用模型，score=1。"
          }
        },
        {
          "name": "SEMANTIC_HIGH_轻微改写",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "UserId",
                "value": "{{userId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paragraph\": \"经本次合同比对确认，（一）私募管理人保证在募集资金前已在中国证券投资基金业协会（以下简称中国基金业协会）登记为私募基金管理人，并取得管理人登记编码。上述内容用于本次变更识别测试。\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/service/contract-change/predict",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "service",
                "contract-change",
                "predict"
              ]
            },
            "description": "文本不完全相同，适合观察语义召回和HIGH/CANDIDATE。"
          }
        },
        {
          "name": "SEMANTIC_CANDIDATE_同主题不同表述",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "UserId",
                "value": "{{userId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paragraph\": \"与原合同相比，（五）私募基金管理人承诺遵循专业化运营的原则，在未经监管部门同意的情况下，不会从事私募投资基金以外的业务。\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/service/contract-change/predict",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "service",
                "contract-change",
                "predict"
              ]
            },
            "description": "适合观察score与similarity的区别。"
          }
        },
        {
          "name": "STRONG_SINGLE_MATCH_FALLBACK_强相似单条兜底",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "UserId",
                "value": "{{userId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paragraph\": \"（七）私募管理人承诺已和相关当事人在基金合同中约定私募基金管理人客观上丧失继续管理私募基金能力的情形下的基金财产安全保障、维持基金运营或清算的应急处置预案和纠纷解决机制，保证即使因违反法律法规或自律规则而被执行注销程序的私募基金管理人和相关当事人，能够根据《基金法》、协会相关自律规则和基金合同的约定，妥善处置基金财产，依法保障投资者的合法权益。上述内容用于本次变更识别测试。\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/service/contract-change/predict",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "service",
                "contract-change",
                "predict"
              ]
            },
            "description": "如果多标签投票没有达标，但第一名相似度较高，可观察CANDIDATE兜底。"
          }
        },
        {
          "name": "NO_RELIABLE_MATCH_无关文本",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "UserId",
                "value": "{{userId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paragraph\": \"本段文字描述办公楼停车位、会议室茶歇安排以及设备巡检计划，与基金合同核心条款没有直接关系。\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/service/contract-change/predict",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "service",
                "contract-change",
                "predict"
              ]
            },
            "description": "预期无可靠历史证据，返回NO_RELIABLE_MATCH或空候选。"
          }
        },
        {
          "name": "ERROR_EMPTY_PARAGRAPH_空段落",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "UserId",
                "value": "{{userId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paragraph\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/service/contract-change/predict",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "service",
                "contract-change",
                "predict"
              ]
            },
            "description": "请求体校验失败，提示合同段落不能为空。"
          }
        },
        {
          "name": "ERROR_TOO_LONG_超长段落",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "UserId",
                "value": "{{userId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
